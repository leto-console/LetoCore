{
    "version": 3,
    "configurePresets": [
		{
			"name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
				"CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/bin/${presetName}",
				"CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/lib/${presetName}",
				"CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/lib/${presetName}",
                "CMAKE_PRESET_NAME": "${presetName}"
            }
		},
        {
            "name": "stm32-base",
			"inherits": "base",
			"hidden": true,
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": {
                    "type": "FILEPATH",
                    "value": "${sourceDir}/cmake/toolchain-arm-none-eabi.cmake"
                },
				"PRESET_DEFINE_MACRO": "__STM32__"
            },
            "architecture": {
                "value": "unspecified",
                "strategy": "external"
            }
        },
        {
            "name": "windows-base",
			"inherits": "base",
			"hidden": true,
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_LINKER": "link",
                "PRESET_DEFINE_MACRO": "__WIN__"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "ubuntu-base",
			"inherits": "base",
			"hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "PRESET_DEFINE_MACRO": "__LINUX__"
            }
        },
        {
            "name": "termux-base",
			"inherits": "base",
			"hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "PRESET_DEFINE_MACRO": "__TERMUX__"
            }
        },
		{
            "name": "stm32f401xc-debug",
            "inherits": "stm32-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
				"MCU_CHIP": "STM32F401xC"
            }
        },
		{
            "name": "stm32f411xe-debug",
            "inherits": "stm32-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
				"MCU_CHIP": "STM32F411xE"
            }
        },
        {
            "name": "win-debug",
            "displayName": "win-debug",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "win-release",
            "displayName": "win-release",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ubuntu-debug",
            "displayName": "ubuntu-debug",
            "inherits": "ubuntu-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PRESET_NAME": "ubuntu-debug"
            }
        },
        {
            "name": "termux-debug",
            "displayName": "termux-debug",
            "inherits": "termux-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PRESET_NAME": "termux-debug"
            }
        },
        {
            "name": "termux-win-debug",
            "displayName": "termux-win-debug",
            "inherits": "windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PRESET_NAME": "termux-win-debug",
                "PRESET_DEFINE_MACRO": "__TERMUX__"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "stm32f401xc-debug",
            "configurePreset": "stm32f401xc-debug"
        },
        {
            "name": "stm32f411xe-debug",
            "configurePreset": "stm32f411xe-debug"
        },
        {
            "name": "win-debug",
            "configurePreset": "win-debug"
        },
        {
            "name": "win-release",
            "configurePreset": "win-release"
        },
        {
            "name": "ubuntu-debug",
            "configurePreset": "ubuntu-debug"
        },
        {
            "name": "termux-debug",
            "configurePreset": "ubuntu-debug"
        }
    ]
}